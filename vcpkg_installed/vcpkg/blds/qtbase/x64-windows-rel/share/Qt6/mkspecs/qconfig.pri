QT_ARCH = x86_64
QT_BUILDABI = 
QT_LIBCPP_ABI_TAG = 
QT.global.enabled_features = version_tagging shared pkg-config signaling_nan thread test_gui test_squish shared intelcet shared
QT.global.disabled_features = static cross_compile debug_and_release separate_debug_info appstore-compliant simulator_and_device rpath force_asserts framework c++20 c++2a c++2b c++2c reduce_relocations wasm-simd128 wasm-exceptions wasm-jspi zstd future concurrent dbus openssl-linked opensslv11 opensslv30
QT.global.disabled_features += release build_all
QT_CONFIG += shared release
CONFIG += release  shared plugin_manifest intelcet
QT_VERSION = 6.11.3
QT_MAJOR_VERSION = 6
QT_MINOR_VERSION = 11
QT_PATCH_VERSION = 3

QT_MSVC_MAJOR_VERSION = 19
QT_MSVC_MINOR_VERSION = 51
QT_MSVC_PATCH_VERSION = 36246
