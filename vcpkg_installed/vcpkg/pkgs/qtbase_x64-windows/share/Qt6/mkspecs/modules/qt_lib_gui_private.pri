QT.gui_private.enabled_features = directwrite directwrite3 directwritecolrv1 direct2d direct2d1_1 emojisegmenter vkgen gif ico imageio-text-loading multiprocess raster-64bit raster-fp qtgui-threadpool wayland-datadevice wayland-client-primary-selection run-opengl-tests
